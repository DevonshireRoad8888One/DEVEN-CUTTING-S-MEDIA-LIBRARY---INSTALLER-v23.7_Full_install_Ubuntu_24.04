bash -c "$(cat <<'INSTALLER_EOF'
#!/bin/bash
# Library Installer v25.3
# Deven Cutting Edition - YouTube-Style + AUTO RANDOM PORT!

set -e
shopt -s nullglob
GOLD="\033[0;33m"; GREEN="\033[0;32m"; CYAN="\033[0[36m"
RED="\033[0;31m"; YELLOW="\033[1[33m"; BLUE="\033[0;34m"; NC="\033[0m"
clear
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}     DEVEN CUTTING'S MEDIA LIBRARY - INSTALLER v25.3${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}        Auto Random Port + YouTube-Style Thumbnails${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo ""

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}Please don't run as root!${NC}"; exit 1; fi

# 🎲 AUTO-GENERATE RANDOM PORT (12345-31337)
RANDOM_PORT=$((RANDOM % 19000 + 12345))
echo -e "${CYAN}🎲 Generated random port: ${YELLOW}$RANDOM_PORT${NC}"
echo ""

if grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=true
    echo -e "${CYAN}WSL detected${NC}"
else
    IS_WSL=false
    echo -e "${CYAN}Native Linux detected${NC}"
fi
echo ""

if [ "$IS_WSL" = true ]; then
    echo -e "${CYAN}Windows users:${NC}"
    echo ""
    USER_LIST=()
    for user_dir in /mnt/c/Users/*/; do
        user=$(basename "$user_dir")
        if [[ "$user" != "Public" && "$user" != "Default" && "$user" != "Default User" && "$user" != "All Users" ]]; then
            USER_LIST+=("$user")
            echo "   [$(( ${#USER_LIST[@]} ))] $user"
        fi
    done
    echo "   [0] Cancel"
    echo ""
    read -p "Enter number: " USER_CHOICE
    [ "$USER_CHOICE" = "0" ] && exit 0
    if ! [[ "$USER_CHOICE" =~ ^[0-9]+$ ]] || [ "$USER_CHOICE" -lt 1 ] || [ "$USER_CHOICE" -gt "${#USER_LIST[@]}" ]; then
        echo -e "${RED}Invalid!${NC}"; exit 1; fi
    WIN_USER="${USER_LIST[$((USER_CHOICE-1))]}"
    INSTALL_DIR="/mnt/c/Users/$WIN_USER/Downloads/ark-library"
    echo -e "${GREEN}Selected: $WIN_USER${NC}"
else
    INSTALL_DIR="$HOME/ark-library"
    WIN_USER=""
    echo -e "${CYAN}Install: $INSTALL_DIR${NC}"
fi

# Check if port is already in use
if command -v ss >/dev/null 2>&1; then
    if ss -tuln 2>/dev/null | grep -q ":$RANDOM_PORT "; then
        echo -e "${YELLOW}Port $RANDOM_PORT is busy, picking another...${NC}"
        RANDOM_PORT=$((RANDOM % 19000 + 12345))
        echo -e "${CYAN}New port: ${YELLOW}$RANDOM_PORT${NC}"
    fi
fi

if [ -d "$INSTALL_DIR" ]; then
    EXISTING_VIDEOS=$(ls "$INSTALL_DIR/videos/" 2>/dev/null | wc -l)
    EXISTING_IMAGES=$(ls "$INSTALL_DIR/images/" 2>/dev/null | wc -l)
    EXISTING_AUDIO=$(ls "$INSTALL_DIR/audio/" 2>/dev/null | wc -l)
    EXISTING_MUSIC=$(ls "$INSTALL_DIR/music/" 2>/dev/null | wc -l)
    if [ "$EXISTING_VIDEOS" -gt 0 ] || [ "$EXISTING_IMAGES" -gt 0 ] || [ "$EXISTING_AUDIO" -gt 0 ] || [ "$EXISTING_MUSIC" -gt 0 ]; then
        echo -e "${YELLOW}Found existing files (will PRESERVE):${NC}"
        echo -e "  Videos: $EXISTING_VIDEOS, Images: $EXISTING_IMAGES, Audio: $EXISTING_AUDIO, Music: $EXISTING_MUSIC"
    fi
fi

# Update system
echo -e "${CYAN}Updating system...${NC}"
sudo apt update -qq && sudo apt upgrade -y -qq
echo -e "${GREEN}Done${NC}"
echo ""

# Install everything
echo -e "${CYAN}Installing Python, ffmpeg, dependencies...${NC}"
sudo apt install -y -qq python3 python3-pip 2>&1 | grep -E "Error|error" || true
sudo apt install -y -qq ffmpeg 2>&1 | grep -E "Error|error" || true
echo -e "${GREEN}Python $(python3 --version 2>&1 | cut -d' ' -f2)${NC}"
if command -v ffmpeg &> /dev/null; then
    echo -e "${GREEN}ffmpeg $(ffmpeg -version 2>&1 | head -1 | cut -d' ' -f3)${NC}"
else
    echo -e "${RED}ffmpeg failed to install!${NC}"
fi
echo ""

# Ensure folders exist
for folder in videos images audio music trash thumbnails; do
    [ -d "$INSTALL_DIR/$folder" ] || mkdir -p "$INSTALL_DIR/$folder"
done

# Manifest generator with thumbnails
cat > "$INSTALL_DIR/generate-manifest.py" << 'PYEOF'
#!/usr/bin/env python3
import os, json, subprocess, hashlib

def scan_folder(folder, extensions):
    items = []
    if os.path.exists(folder):
        for f in sorted(os.listdir(folder)):
            if f.lower().endswith(extensions):
                items.append(f)
    return items

def make_thumbnail(video_file, thumb_dir):
    base_name = os.path.splitext(video_file)[0]
    safe_name = hashlib.md5(video_file.encode()).hexdigest()[:10] + '_' + base_name[:30]
    safe_name = ''.join(c for c in safe_name if c.isalnum() or c in '-_')
    thumb_path = os.path.join(thumb_dir, safe_name + '.jpg')
    if os.path.exists(thumb_path):
        return safe_name + '.jpg'
    try:
        subprocess.run([
            'ffmpeg', '-i', os.path.join('videos', video_file),
            '-ss', '00:00:05', '-vframes', '1',
            '-vf', 'scale=640:-1',
            '-y', thumb_path
        ], check=True, capture_output=True, timeout=30)
        return safe_name + '.jpg'
    except:
        try:
            subprocess.run([
                'ffmpeg', '-i', os.path.join('videos', video_file),
                '-vframes', '1', '-vf', 'scale=640:-1',
                '-y', thumb_path
            ], check=True, capture_output=True, timeout=30)
            return safe_name + '.jpg'
        except:
            return None

videos = scan_folder("videos", (".mp4", ".mov", ".webm", ".avi", ".mkv"))
images = scan_folder("images", (".png", ".jpg", ".jpeg", ".gif", ".webp"))
audio = scan_folder("audio", (".mp3", ".wav", ".ogg", ".m4a", ".flac"))
music = scan_folder("music", (".mp3", ".wav", ".ogg", ".m4a", ".flac"))

print("Generating thumbnails...")
thumb_dir = "thumbnails"
os.makedirs(thumb_dir, exist_ok=True)
thumbnails = {}
for video in videos:
    thumb = make_thumbnail(video, thumb_dir)
    thumbnails[video] = thumb

manifest = {
    "videos": videos,
    "images": images,
    "audio": audio,
    "music": music,
    "thumbnails": thumbnails
}
with open("manifest.json", "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2, ensure_ascii=False)

print(f"Videos: {len(videos)}, Images: {len(images)}, Audio: {len(audio)}, Music: {len(music)}")
print(f"Thumbnails: {sum(1 for t in thumbnails.values() if t)} generated")
PYEOF

# Save config (WITH PORT!)
echo "$INSTALL_DIR" > ~/.ark_install_dir
echo "$RANDOM_PORT" > ~/.ark_port
[ "$IS_WSL" = true ] && echo "true" > ~/.ark_is_wsl || echo "false" > ~/.ark_is_wsl

mkdir -p ~/.local/bin

# ark command (uses saved port)
cat > ~/.local/bin/ark <<'ARK_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
ARK_PORT="$(cat ~/.ark_port 2>/dev/null)"
IS_WSL="$(cat ~/.ark_is_wsl 2>/dev/null)"
C_RED='\033[0;31m'; C_GRN='\033[0;32m'; C_CYN='\033[0[36m'; C_YEL='\033[1[33m'; NC='\033[0m'
if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED}ark-library not found!${NC}"; exit 1; fi
if [ -z "$ARK_PORT" ]; then
    echo -e "${C_RED}Port not set! Re-run installer.${NC}"; exit 1; fi
pkill -f "http.server" 2>/dev/null
sleep 2
echo -e "${C_CYN}Refreshing (port $ARK_PORT)...${NC}"
cd "$ARK_DIR"
python3 generate-manifest.py
nohup python3 "$ARK_DIR/delete-handler.py" > /tmp/ark-library.log 2>&1 &
sleep 2
if command -v ss >/dev/null 2>&1; then
    ss -tuln 2>/dev/null | grep -q ":$ARK_PORT " && UP=1 || UP=0
else
    pgrep -f "delete-handler.py" >/dev/null && UP=1 || UP=0
fi
if [ "$UP" = "1" ]; then
    echo -e "${C_GRN}Server started!${NC}"
    echo -e "${C_CYN}http://localhost:$ARK_PORT${NC}"
    echo -e "${C_YEL}Press Ctrl+Shift+R!${NC}"
    [ "$IS_WSL" = "true" ] && powershell.exe -Command "Start-Process 'http://localhost:$ARK_PORT'" 2>/dev/null || xdg-open "http://localhost:$ARK_PORT" 2>/dev/null
else
    echo -e "${C_RED}Server failed${NC}"; cat /tmp/ark-library.log; fi
ARK_EOF
chmod +x ~/.local/bin/ark

# ark-port command (shows you the port!)
cat > ~/.local/bin/ark-port <<'PORT_EOF'
#!/bin/bash
C_CYN='\033[0[36m'; C_YEL='\033[1[33m'; NC='\033[0m'
ARK_PORT="$(cat ~/.ark_port 2>/dev/null)"
if [ -z "$ARK_PORT" ]; then
    echo "No port set. Run installer first."
else
    echo -e "${C_CYN}Your library is on port: ${C_YEL}$ARK_PORT${NC}"
    echo -e "${C_CYN}Access at: ${C_YEL}http://localhost:$ARK_PORT${NC}"
fi
PORT_EOF
chmod +x ~/.local/bin/ark-port

# ark-add
cat > ~/.local/bin/ark-add <<'ARK_ADD_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
C_CYN='\033[0[36m'; C_RED='\033[0;31m'; C_GRN='\033[0;32m'; C_YEL='\033[1[33m'; NC='\033[0m'
if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED}ark-library not found!${NC}"; exit 1; fi
cd "$ARK_DIR"
echo -e "${C_CYN}Updating (generating thumbnails)...${NC}"
python3 generate-manifest.py
echo -e "${C_GRN}Done!${NC}"
ARK_ADD_EOF
chmod +x ~/.local/bin/ark-add

# ark-stop
cat > ~/.local/bin/ark-stop <<'STOP_EOF'
#!/bin/bash
pkill -f "http.server" 2>/dev/null && echo "Stopped!" || echo "Not running"
STOP_EOF
chmod +x ~/.local/bin/ark-stop

# ark-trash
cat > ~/.local/bin/ark-trash <<'TRASH_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
TRASH="$ARK_DIR/trash"
if [ ! -d "$TRASH" ]; then echo "No trash"; exit 0; fi
COUNT=$(ls "$TRASH" 2>/dev/null | wc -l)
[ "$COUNT" -eq 0 ] && echo "Empty" || (echo "$COUNT items:"; ls "$TRASH")
TRASH_EOF
chmod +x ~/.local/bin/ark-trash

# PATH
if ! grep -q ".local/bin" ~/.bashrc 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc; fi
export PATH="$HOME/.local/bin:$PATH"

# Create delete-handler.py (with dynamic port!)
cat > "$INSTALL_DIR/delete-handler.py" << 'PYEOF'
#!/usr/bin/env python3
import http.server, socketserver, os, json, urllib.parse, time

# Read port from config
PORT_FILE = os.path.expanduser("~/.ark_port")
try:
    with open(PORT_FILE) as f:
        PORT = int(f.read().strip())
except:
    PORT = 9000  # Fallback

DIRECTORY = "/mnt/c/Users/tooex/Downloads/ark-library"

class DeleteHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=DIRECTORY, **kwargs)
   
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        if parsed.path == '/delete':
            folder = params.get('folder', [''])[0]
            filename = params.get('file', [''])[0]
            if folder not in ['videos', 'images', 'audio', 'music']:
                self.send_error(400, "Invalid folder")
                return
            if '..' in filename or '/' in filename or '\\' in filename:
                self.send_error(400, "Invalid filename")
                return
            filepath = os.path.join(DIRECTORY, folder, filename)
            if not os.path.exists(filepath):
                self.send_response(404)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"success": False, "error": "Not found"}).encode())
                return
            try:
                trash_dir = os.path.join(DIRECTORY, 'trash')
                os.makedirs(trash_dir, exist_ok=True)
                timestamp = str(int(time.time()))
                trash_filename = timestamp + '_' + filename
                trash_path = os.path.join(trash_dir, trash_filename)
                os.rename(filepath, trash_path)
                os.system(f'cd "{DIRECTORY}" && python3 generate-manifest.py > /dev/null 2>&1')
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"success": True}).encode())
            except Exception as e:
                self.send_response(500)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"success": False, "error": str(e)}).encode())
            return
        return super().do_GET()
   
    def log_message(self, format, *args):
        pass

if __name__ == "__main__":
    os.chdir(DIRECTORY)
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("", PORT), DeleteHandler) as httpd:
        print(f"Server: {DIRECTORY}")
        print(f"Port: {PORT}")
        print(f"http://localhost:{PORT}")
        httpd.serve_forever()
PYEOF

# Create the YouTube-style HTML
cat > "$INSTALL_DIR/index.html" << 'HTMLEOF'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deven Cutting's Media Library</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
  background: linear-gradient(135deg, #0a1929 0%, #1e3a5f 50%, #2c5282 100%);
  background-attachment: fixed;
  color: #e8f0f7;
  min-height: 100vh;
  line-height: 1.6;
}
.header { text-align: center; padding: 60px 20px 40px; border-bottom: 2px solid #00d4ff; background: rgba(0, 212, 255, 0.05); }
.header h1 { font-size: 2.8rem; color: #fff; font-weight: 300; letter-spacing: 1px; }
.header .subtitle { color: #00d4ff; font-size: 1.1rem; margin-top: 8px; font-weight: 500; }
.header .name { color: #ffd700; font-size: 1.3rem; margin-top: 15px; font-style: italic; }
.header .tagline { color: #b0c4de; font-size: 1rem; margin-top: 10px; font-style: italic; }
.header .port-info { color: #00d4ff; font-size: 0.9rem; margin-top: 8px; opacity: 0.8; }
.stats { display: flex; justify-content: center; gap: 30px; flex-wrap: wrap; padding: 25px; background: rgba(10, 25, 41, 0.6); border-bottom: 1px solid rgba(0, 212, 255, 0.3); }
.stat { text-align: center; }
.stat-number { font-size: 2rem; color: #00d4ff; font-weight: bold; display: block; }
.stat-label { font-size: 0.85rem; color: #b0c4de; text-transform: uppercase; letter-spacing: 1px; }
nav { background: rgba(10, 25, 41, 0.95); padding: 15px 0; text-align: center; position: sticky; top: 0; z-index: 100; border-bottom: 2px solid #00d4ff; }
nav a { color: #e8f0f7; text-decoration: none; margin: 0 20px; font-weight: 500; transition: color 0.3s; }
nav a:hover { color: #00d4ff; }
section { max-width: 1300px; margin: 40px auto; padding: 0 20px; }
.section-title { font-size: 2rem; color: #00d4ff; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid rgba(0, 212, 255, 0.3); font-weight: 300; }
.video-grid, .audio-grid, .music-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 25px; }
.video-thumb {
  background: rgba(10, 25, 41, 0.7);
  border: 1px solid rgba(0, 212, 255, 0.2);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.3s, border-color 0.3s;
  cursor: pointer;
  position: relative;
}
.video-thumb:hover { border-color: #00d4ff; transform: translateY(-3px); }
.thumb-image {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  background: #000;
  overflow: hidden;
}
.thumb-image img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.thumb-image .play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60px;
  height: 60px;
  background: rgba(0, 212, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: white;
  opacity: 0.8;
  transition: opacity 0.3s, transform 0.3s;
}
.video-thumb:hover .play-icon { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
.thumb-info { padding: 12px 15px; }
.thumb-info h3 { color: #fff; font-size: 0.9rem; font-weight: 400; line-height: 1.3; }
.audio-card, .music-card {
  background: rgba(10, 25, 41, 0.7);
  border: 1px solid rgba(0, 212, 255, 0.2);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.3s, border-color 0.3s;
  position: relative;
}
.audio-card:hover, .music-card:hover { border-color: #00d4ff; }
.audio-info, .music-info { padding: 15px; padding-right: 50px; }
.audio-info h3, .music-info h3 { color: #fff; font-size: 0.95rem; font-weight: 400; }
.audio-card audio, .music-card audio { width: 100%; margin-top: 10px; }
.music-card { background: linear-gradient(135deg, rgba(255, 215, 0, 0.05), rgba(0, 212, 255, 0.05)); }
.music-info h3 { color: #ffd700; }
.gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
.gallery-item { position: relative; overflow: hidden; border-radius: 12px; border: 2px solid rgba(0, 212, 255, 0.2); cursor: pointer; transition: transform 0.3s, border-color 0.3s; }
.gallery-item:hover { border-color: #00d4ff; transform: translateY(-3px); }
.gallery-item img { width: 100%; height: 280px; object-fit: cover; display: block; }
.gallery-caption { padding: 12px; text-align: center; background: rgba(10, 25, 41, 0.9); color: #e8f0f7; font-size: 0.85rem; }
.delete-btn { position: absolute; top: 8px; right: 8px; background: rgba(220, 38, 38, 0.85); color: white; border: none; border-radius: 50%; width: 32px; height: 32px; font-size: 16px; cursor: pointer; z-index: 10; font-weight: bold; }
.delete-btn:hover { background: rgba(239, 68, 68, 1); }
.delete-btn-large { position: absolute; top: 8px; right: 8px; background: rgba(220, 38, 38, 0.85); color: white; border: none; border-radius: 6px; padding: 6px 10px; font-size: 0.8rem; cursor: pointer; z-index: 10; font-weight: 500; }
.delete-btn-large:hover { background: rgba(239, 68, 68, 1); }
.status-msg { text-align: center; padding: 40px; grid-column: 1/-1; color: #b0c4de; }
.player-modal { display: none; position: fixed; z-index: 10000; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.95); justify-content: center; align-items: center; flex-direction: column; }
.player-modal.active { display: flex; }
.player-container { max-width: 90vw; max-height: 85vh; width: 1200px; }
.player-container video { width: 100%; height: auto; max-height: 80vh; border: 3px solid #00d4ff; border-radius: 8px; }
.player-caption { color: #00d4ff; margin-top: 15px; font-size: 1.1rem; text-align: center; padding: 0 20px; }
.player-close { position: absolute; top: 20px; right: 30px; color: #00d4ff; font-size: 2.5rem; cursor: pointer; font-weight: bold; }
.player-close:hover { color: #fff; }
.modal { display: none; position: fixed; z-index: 10000; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.8); justify-content: center; align-items: center; }
.modal.active { display: flex; }
.modal-content { background: rgba(10, 25, 41, 0.95); border: 2px solid #00d4ff; border-radius: 12px; padding: 30px; max-width: 400px; text-align: center; }
.modal-content h3 { color: #00d4ff; margin-bottom: 15px; }
.modal-content p { color: #e8f0f7; margin-bottom: 20px; }
.modal-buttons { display: flex; gap: 10px; justify-content: center; }
.modal-btn { padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: 500; font-size: 0.95rem; }
.modal-btn-confirm { background: #dc2626; color: white; }
.modal-btn-cancel { background: #4b5563; color: white; }
footer { text-align: center; padding: 40px 20px; border-top: 2px solid #00d4ff; margin-top: 80px; background: rgba(10, 25, 41, 0.6); }
footer h3 { color: #00d4ff; margin-bottom: 10px; font-weight: 400; }
footer .license { color: #ffd700; font-size: 0.9rem; margin-top: 15px; }
footer .author { color: #b0c4de; font-size: 1rem; margin-top: 8px; }
.lightbox { display: none; position: fixed; z-index: 9999; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.95); justify-content: center; align-items: center; flex-direction: column; }
.lightbox.active { display: flex; }
.lightbox img { max-width: 95%; max-height: 85vh; object-fit: contain; border: 3px solid #00d4ff; border-radius: 8px; }
.lightbox-caption { color: #00d4ff; margin-top: 15px; font-size: 1.1rem; }
.lightbox-close { position: absolute; top: 20px; right: 30px; color: #00d4ff; font-size: 2.5rem; cursor: pointer; }
</style>
</head>
<body>
<div class="header">
<h1>Deven Cutting's Media Library</h1>
<div class="subtitle">Personal Collection</div>
<div class="name">— Deven Cutting —</div>
<div class="tagline">Curating Knowledge, Media & Creative Works</div>
<div class="port-info">🔒 Secured on random port</div>
</div>

<div class="stats">
<div class="stat"><span class="stat-number" id="videoCount">0</span><span class="stat-label">Videos</span></div>
<div class="stat"><span class="stat-number" id="imageCount">0</span><span class="stat-label">Images</span></div>
<div class="stat"><span class="stat-number" id="audioCount">0</span><span class="stat-label">Audio</span></div>
<div class="stat"><span class="stat-number" id="musicCount">0</span><span class="stat-label">Music</span></div>
</div>

<nav>
