bash -c "$(cat <<'INSTALLER_EOF'
#!/bin/bash
# Library Installer v24.4
# Deven Cutting Edition - Blue/Cyan + Music + DELETE BUTTONS!

set -e
shopt -s nullglob
GOLD="\033[0;33m"; GREEN="\033[0;32m"; CYAN="\033[0;36m"
RED="\033[0;31m"; YELLOW="\033[1;33m"; BLUE="\033[0;34m"; NC="\033[0m"
clear
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}     DEVEN CUTTING'S MEDIA LIBRARY - INSTALLER v24.4${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}        With Music Section + Delete Buttons!${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo ""

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}Please don't run as root!${NC}"; exit 1; fi

if grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=true
    echo -e "${CYAN}WSL detected${NC}"
else
    IS_WSL=false
    echo -e "${CYAN}Native Linux detected${NC}"
fi
echo ""

if [ "$IS_WSL" = true ]; then
    echo -e "${CYAN}Windows users:${NC}"
    echo ""
    USER_LIST=()
    for user_dir in /mnt/c/Users/*/; do
        user=$(basename "$user_dir")
        if [[ "$user" != "Public" && "$user" != "Default" && "$user" != "Default User" && "$user" != "All Users" ]]; then
            USER_LIST+=("$user")
            echo "   [$(( ${#USER_LIST[@]} ))] $user"
        fi
    done
    echo "   [0] Cancel"
    echo ""
    read -p "Enter number: " USER_CHOICE
    [ "$USER_CHOICE" = "0" ] && exit 0
    if ! [[ "$USER_CHOICE" =~ ^[0-9]+$ ]] || [ "$USER_CHOICE" -lt 1 ] || [ "$USER_CHOICE" -gt "${#USER_LIST[@]}" ]; then
        echo -e "${RED}Invalid!${NC}"; exit 1; fi
    WIN_USER="${USER_LIST[$((USER_CHOICE-1))]}"
    INSTALL_DIR="/mnt/c/Users/$WIN_USER/Downloads/ark-library"
    echo -e "${GREEN}Selected: $WIN_USER${NC}"
else
    INSTALL_DIR="$HOME/ark-library"
    WIN_USER=""
    echo -e "${CYAN}Install: $INSTALL_DIR${NC}"
fi

if [ -d "$INSTALL_DIR" ]; then
    EXISTING_VIDEOS=$(ls "$INSTALL_DIR/videos/" 2>/dev/null | wc -l)
    EXISTING_IMAGES=$(ls "$INSTALL_DIR/images/" 2>/dev/null | wc -l)
    EXISTING_AUDIO=$(ls "$INSTALL_DIR/audio/" 2>/dev/null | wc -l)
    EXISTING_MUSIC=$(ls "$INSTALL_DIR/music/" 2>/dev/null | wc -l)
    EXISTING_TRASH=$(ls "$INSTALL_DIR/trash/" 2>/dev/null | wc -l)
    if [ "$EXISTING_VIDEOS" -gt 0 ] || [ "$EXISTING_IMAGES" -gt 0 ] || [ "$EXISTING_AUDIO" -gt 0 ] || [ "$EXISTING_MUSIC" -gt 0 ]; then
        echo -e "${YELLOW}Found existing files (will PRESERVE):${NC}"
        echo -e "  Videos: $EXISTING_VIDEOS, Images: $EXISTING_IMAGES, Audio: $EXISTING_AUDIO, Music: $EXISTING_MUSIC"
        echo -e "  Trash: $EXISTING_TRASH items"
    fi
fi

# Ensure folders exist
for folder in videos images audio music trash; do
    [ -d "$INSTALL_DIR/$folder" ] || mkdir -p "$INSTALL_DIR/$folder"
done

# Manifest generator
cat > "$INSTALL_DIR/generate-manifest.py" << 'PYEOF'
#!/usr/bin/env python3
import os, json
def scan_folder(folder, extensions):
    items = []
    if os.path.exists(folder):
        for f in sorted(os.listdir(folder)):
            if f.lower().endswith(extensions):
                items.append(f)
    return items
videos = scan_folder("videos", (".mp4", ".mov", ".webm", ".avi", ".mkv"))
images = scan_folder("images", (".png", ".jpg", ".jpeg", ".gif", ".webp"))
audio = scan_folder("audio", (".mp3", ".wav", ".ogg", ".m4a", ".flac"))
music = scan_folder("music", (".mp3", ".wav", ".ogg", ".m4a", ".flac"))
manifest = {"videos": videos, "images": images, "audio": audio, "music": music}
with open("manifest.json", "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2, ensure_ascii=False)
print(f"Videos: {len(videos)}, Images: {len(images)}, Audio: {len(audio)}, Music: {len(music)}")
PYEOF

# Save config
echo "$INSTALL_DIR" > ~/.ark_install_dir
[ "$IS_WSL" = true ] && echo "true" > ~/.ark_is_wsl || echo "false" > ~/.ark_is_wsl
mkdir -p ~/.local/bin

# ark command
cat > ~/.local/bin/ark <<'ARK_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
IS_WSL="$(cat ~/.ark_is_wsl 2>/dev/null)"
C_RED='\033[0;31m'; C_GRN='\033[0;32m'; C_CYN='\033[0;36m'; C_YEL='\033[1;33m'; NC='\033[0m'
if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED}ark-library not found at: $ARK_DIR${NC}"; exit 1; fi
pkill -f "http.server 9000" 2>/dev/null; sleep 2
echo -e "${C_CYN}Refreshing...${NC}"
cd "$ARK_DIR"
python3 generate-manifest.py
touch "$INSTALL_DIR/index.html"
nohup python3 -m http.server 9000 --bind 0.0.0.0 > /tmp/ark-library.log 2>&1 &
sleep 2
if command -v ss >/dev/null 2>&1; then
    ss -tuln 2>/dev/null | grep -q ":9000 " && UP=1 || UP=0
else
    pgrep -f "http.server 9000" >/dev/null && UP=1 || UP=0
fi
if [ "$UP" = "1" ]; then
    echo -e "${C_GRN}Server started!${NC}"
    echo -e "${C_CYN}http://localhost:9000${NC}"
    echo -e "${C_YEL}Press Ctrl+Shift+R in browser!${NC}"
    [ "$IS_WSL" = "true" ] && powershell.exe -Command "Start-Process 'http://localhost:9000'" 2>/dev/null || xdg-open "http://localhost:9000" 2>/dev/null
else
    echo -e "${C_RED}Server failed${NC}"; cat /tmp/ark-library.log; fi
ARK_EOF
chmod +x ~/.local/bin/ark

# ark-add command
cat > ~/.local/bin/ark-add <<'ARK_ADD_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
C_CYN='\033[0;36m'; C_RED='\033[0;31m'; C_GRN='\033[0;32m'; C_YEL='\033[1;33m'; NC='\033[0m'
if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED}ark-library not found!${NC}"; exit 1; fi
cd "$ARK_DIR"
echo -e "${C_CYN}Updating...${NC}"
python3 generate-manifest.py
echo -e "${C_GRN}Done!${NC}"
ARK_ADD_EOF
chmod +x ~/.local/bin/ark-add

# ark-stop command
cat > ~/.local/bin/ark-stop <<'STOP_EOF'
#!/bin/bash
pkill -f "http.server 9000" 2>/dev/null && echo "Stopped!" || echo "Not running"
STOP_EOF
chmod +x ~/.local/bin/ark-stop

# ark-trash command (restore deleted files)
cat > ~/.local/bin/ark-trash <<'TRASH_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
C_CYN='\033[0;36m'; C_GRN='\033[0;32m'; C_YEL='\033[1[33m'; NC='\033[0m'
TRASH="$ARK_DIR/trash"
if [ ! -d "$TRASH" ]; then
    echo "No trash folder"; exit 0; fi
COUNT=$(ls "$TRASH" 2>/dev/null | wc -l)
if [ "$COUNT" -eq 0 ]; then
    echo "Trash is empty"
else
    echo "Trash has $COUNT item(s):"
    ls "$TRASH"
    echo ""
    echo "To restore all: mv $TRASH/* $ARK_DIR/videos/  (or appropriate folder)"
fi
TRASH_EOF
chmod +x ~/.local/bin/ark-trash

# Add to PATH
if ! grep -q ".local/bin" ~/.bashrc 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc; fi
export PATH="$HOME/.local/bin:$PATH"

# Create the index.html WITH DELETE BUTTONS
cat > "$INSTALL_DIR/index.html" << 'HTMLEOF'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deven Cutting's Media Library</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
  background: linear-gradient(135deg, #0a1929 0%, #1e3a5f 50%, #2c5282 100%);
  background-attachment: fixed;
  color: #e8f0f7;
  min-height: 100vh;
  line-height: 1.6;
}
.header {
  text-align: center;
  padding: 60px 20px 40px;
  border-bottom: 2px solid #00d4ff;
  background: rgba(0, 212, 255, 0.05);
}
.header h1 { font-size: 2.8rem; color: #fff; font-weight: 300; letter-spacing: 1px; }
.header .subtitle { color: #00d4ff; font-size: 1.1rem; margin-top: 8px; }
.header .name { color: #ffd700; font-size: 1.3rem; margin-top: 15px; font-style: italic; }
.header .tagline { color: #b0c4de; font-size: 1rem; margin-top: 10px; font-style: italic; }
.stats {
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;
  padding: 25px;
  background: rgba(10, 25, 41, 0.6);
  border-bottom: 1px solid rgba(0, 212, 255, 0.3);
}
.stat { text-align: center; }
.stat-number { font-size: 2rem; color: #00d4ff; font-weight: bold; display: block; }
.stat-label { font-size: 0.85rem; color: #b0c4de; text-transform: uppercase; letter-spacing: 1px; }
nav {
  background: rgba(10, 25, 41, 0.95);
  padding: 15px 0;
  text-align: center;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 2px solid #00d4ff;
}
nav a {
  color: #e8f0f7;
  text-decoration: none;
  margin: 0 20px;
  font-weight: 500;
  transition: color 0.3s;
}
nav a:hover { color: #00d4ff; }
section { max-width: 1300px; margin: 40px auto; padding: 0 20px; }
.section-title {
  font-size: 2rem;
  color: #00d4ff;
  margin-bottom: 25px;
  padding-bottom: 15px;
  border-bottom: 1px solid rgba(0, 212, 255, 0.3);
  font-weight: 300;
}
.video-grid, .audio-grid, .music-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
  gap: 25px;
}
.video-card, .audio-card, .music-card {
  background: rgba(10, 25, 41, 0.7);
  border: 1px solid rgba(0, 212, 255, 0.2);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
  position: relative;
}
.video-card:hover, .audio-card:hover, .music-card:hover {
  border-color: #00d4ff;
  box-shadow: 0 8px 25px rgba(0, 212, 255, 0.2);
}
.video-wrapper {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  background: #000;
}
.video-wrapper video {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}
.video-info, .audio-info, .music-info {
  padding: 15px;
  padding-right: 50px;
}
.video-info h3, .audio-info h3, .music-info h3 {
  color: #fff;
  font-size: 0.95rem;
  font-weight: 400;
}
.audio-card audio, .music-card audio {
  width: 100%;
  margin-top: 10px;
}
.music-card {
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.05), rgba(0, 212, 255, 0.05));
}
.music-info h3 { color: #ffd700; }
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}
.gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  border: 2px solid rgba(0, 212, 255, 0.2);
  cursor: pointer;
  transition: transform 0.3s, border-color 0.3s;
}
.gallery-item:hover {
  border-color: #00d4ff;
  transform: translateY(-3px);
}
.gallery-item img {
  width: 100%;
  height: 280px;
  object-fit: cover;
  display: block;
}
.gallery-caption {
  padding: 12px;
  text-align: center;
  background: rgba(10, 25, 41, 0.9);
  color: #e8f0f7;
  font-size: 0.85rem;
}
/* DELETE BUTTONS */
.delete-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  background: rgba(220, 38, 38, 0.85);
  color: white;
  border: none;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  font-size: 16px;
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, transform 0.2s;
  font-weight: bold;
}
.delete-btn:hover {
  background: rgba(239, 68, 68, 1);
  transform: scale(1.15);
}
.delete-btn-large {
  position: absolute;
  top: 8px;
  right: 8px;
  background: rgba(220, 38, 38, 0.85);
  color: white;
  border: none;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 0.8rem;
  cursor: pointer;
  z-index: 10;
  font-weight: 500;
}
.delete-btn-large:hover {
  background: rgba(239, 68, 68, 1);
}
.status-msg {
  text-align: center;
  padding: 40px;
  grid-column: 1/-1;
  color: #b0c4de;
}
/* Confirm Modal */
.modal {
  display: none;
  position: fixed;
  z-index: 10000;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  justify-content: center;
  align-items: center;
}
.modal.active { display: flex; }
.modal-content {
  background: rgba(10, 25, 41, 0.95);
  border: 2px solid #00d4ff;
  border-radius: 12px;
  padding: 30px;
  max-width: 400px;
  text-align: center;
}
.modal-content h3 { color: #00d4ff; margin-bottom: 15px; }
.modal-content p { color: #e8f0f7; margin-bottom: 20px; }
.modal-buttons { display: flex; gap: 10px; justify-content: center; }
.modal-btn {
  padding: 10px 20px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 500;
  font-size: 0.95rem;
}
.modal-btn-confirm { background: #dc2626; color: white; }
.modal-btn-confirm:hover { background: #ef4444; }
.modal-btn-cancel { background: #4b5563; color: white; }
.modal-btn-cancel:hover { background: #6b7280; }
footer {
  text-align: center;
  padding: 40px 20px;
  border-top: 2px solid #00d4ff;
  margin-top: 80px;
  background: rgba(10, 25, 41, 0.6);
}
footer h3 { color: #00d4ff; margin-bottom: 10px; font-weight: 400; }
footer .license { color: #ffd700; font-size: 0.9rem; margin-top: 15px; }
footer .author { color: #b0c4de; font-size: 1rem; margin-top: 8px; }
.lightbox {
  display: none;
  position: fixed;
  z-index: 9999;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
.lightbox.active { display: flex; }
.lightbox img {
  max-width: 95%;
  max-height: 85vh;
  object-fit: contain;
  border: 3px solid #00d4ff;
  border-radius: 8px;
}
.lightbox-caption {
  color: #00d4ff;
  margin-top: 15px;
  font-size: 1.1rem;
}
.lightbox-close {
  position: absolute;
  top: 20px;
  right: 30px;
  color: #00d4ff;
  font-size: 2.5rem;
  cursor: pointer;
}
</style>
</head>
<body>
<div class="header">
<h1>Deven Cutting's Media Library</h1>
<div class="subtitle">Personal Collection</div>
<div class="name">— Deven Cutting —</div>
<div class="tagline">Curating Knowledge, Media & Creative Works</div>
</div>

<div class="stats">
<div class="stat"><span class="stat-number" id="videoCount">0</span><span class="stat-label">Videos</span></div>
<div class="stat"><span class="stat-number" id="imageCount">0</span><span class="stat-label">Images</span></div>
<div class="stat"><span class="stat-number" id="audioCount">0</span><span class="stat-label">Audio</span></div>
<div class="stat"><span class="stat-number" id="musicCount">0</span><span class="stat-label">Music</span></div>
</div>

<nav>
<a href="#videos">Videos</a>
<a href="#audio">Audio</a>
<a href="#music">Music</a>
<a href="#gallery">Gallery</a>
</nav>

<section id="videos">
<h2 class="section-title">Video Collection</h2>
<div class="video-grid" id="videoGrid"><div class="status-msg">Loading...</div></div>
</section>

<section id="audio">
<h2 class="section-title">Audio Messages</h2>
<div class="audio-grid" id="audioGrid"><div class="status-msg">Loading...</div></div>
</section>

<section id="music">
<h2 class="section-title">Music Library</h2>
<div class="music-grid" id="musicGrid"><div class="status-msg">Loading...</div></div>
</section>

<section id="gallery">
<h2 class="section-title">Image Gallery</h2>
<div class="gallery" id="imageGrid"><div class="status-msg">Loading...</div></div>
</section>

<footer>
<h3>Deven Cutting's Media Library</h3>
<p class="author">Created & Maintained by <strong>Deven Cutting</strong></p>
<p class="license">Released under the MIT License</p>
<p style="margin-top: 15px; opacity: 0.7; font-size: 0.85rem;">
Copyright © 2026 Deven Cutting. All rights reserved.
</p>
<p style="margin-top: 8px; opacity: 0.6; font-size: 0.8rem;">
Permission is hereby granted, free of charge, to any person obtaining a copy of this software
and associated documentation files (the "Software"), to deal in the Software without restriction.
</p>
</footer>

<!-- Delete Confirmation Modal -->
<div class="modal" id="deleteModal">
<div class="modal-content">
<h3>🗑️ Delete File?</h3>
<p id="deleteMessage">Are you sure you want to delete this file?</p>
<div class="modal-buttons">
<button class="modal-btn modal-btn-cancel" onclick="closeDeleteModal()">Cancel</button>
<button class="modal-btn modal-btn-confirm" id="confirmDeleteBtn">Delete</button>
</div>
</div>
</div>

<div class="lightbox" id="lightbox">
<span class="lightbox-close" id="lightbox-close">&times;</span>
<img id="lightbox-img" src="" alt="">
<div class="lightbox-caption" id="lightbox-caption"></div>
</div>

<script>
// File delete state
let deleteTarget = null;

function cleanName(f) {
  return f.replace(/\.[^.]+$/, '').replace(/^\d{8}_\d+_/, '').replace(/_202\d-\d{2}-\d{2}.*$/, '').replace(/_\([^)]+\)/g, '').replace(/_-_/g, ' - ').replace(/_/g, ' ').trim();
}

// Escape filename for HTML attributes
function escAttr(s) {
  return s.replace(/'/g, "\\'").replace(/"/g, "&quot;");
}

function createVideoCard(f) {
  var name = cleanName(f);
  return '<div class="video-card"><button class="delete-btn" onclick="confirmDelete(\'videos\', \'' + escAttr(f) + '\')" title="Delete this video">×</button><div class="video-wrapper"><video controls preload="none"><source src="videos/' + encodeURIComponent(f) + '" type="video/mp4"></video></div><div class="video-info"><h3>' + name + '</h3></div></div>';
}

function createImageCard(f) {
  var name = cleanName(f);
  return '<div class="gallery-item" data-src="images/' + encodeURIComponent(f) + '" data-caption="' + escAttr(name) + '"><button class="delete-btn-large" onclick="confirmDelete(\'images\', \'' + escAttr(f) + '\', event)" title="Delete this image">🗑 Delete</button><img src="images/' + encodeURIComponent(f) + '" alt="' + escAttr(name) + '" loading="lazy"><div class="gallery-caption">' + name + '</div></div>';
}

function createAudioCard(f) {
  var name = cleanName(f);
  return '<div class="audio-card"><button class="delete-btn" onclick="confirmDelete(\'audio\', \'' + escAttr(f) + '\')" title="Delete this audio">×</button><div class="audio-info"><h3>' + name + '</h3><audio controls preload="none" style="width:100%; margin-top:10px;"><source src="audio/' + encodeURIComponent(f) + '" type="audio/mpeg"></audio></div></div>';
}

function createMusicCard(f) {
  var name = cleanName(f);
  return '<div class="music-card"><button class="delete-btn" onclick="confirmDelete(\'music\', \'' + escAttr(f) + '\')" title="Delete this music">×</button><div class="music-info"><h3>' + name + '</h3><audio controls preload="none" style="width:100%; margin-top:10px;"><source src="music/' + encodeURIComponent(f) + '" type="audio/mpeg"></audio></div></div>';
}

// Delete functionality
function confirmDelete(folder, filename, evt) {
  if (evt) evt.stopPropagation();
  deleteTarget = { folder: folder, filename: filename };
  document.getElementById('deleteMessage').textContent = 'Move "' + filename.substring(0, 50) + '" to trash?';
  document.getElementById('deleteModal').classList.add('active');
}

function closeDeleteModal() {
  document.getElementById('deleteModal').classList.remove('active');
  deleteTarget = null;
}

document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
  if (!deleteTarget) return;
  var folder = deleteTarget.folder;
  var filename = deleteTarget.filename;
  
  // Send delete request to server
  fetch('/delete?folder=' + encodeURIComponent(folder) + '&file=' + encodeURIComponent(filename))
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        // Remove the item from the page
        var cards = document.querySelectorAll('.video-card, .audio-card, .music-card, .gallery-item');
        for (var i = 0; i < cards.length; i++) {
          if (cards[i].querySelector('[src*="' + filename + '"]') || cards[i].outerHTML.indexOf(filename) !== -1) {
            cards[i].style.opacity = '0';
            setTimeout(function(el) { el.remove(); }, 300, cards[i]);
            break;
          }
        }
        // Update counts
        var counts = {
          videos: document.querySelectorAll('.video-card').length - 1,
          images: document.querySelectorAll('.gallery-item').length - 1,
          audio: document.querySelectorAll('.audio-card').length - 1,
          music: document.queryElementCount ? 0 : document.querySelectorAll('.music-card').length - 1
        };
        if (folder === 'videos') document.getElementById('videoCount').textContent = Math.max(0, parseInt(document.getElementById('videoCount').textContent) - 1);
        if (folder === 'images') document.getElementById('imageCount').textContent = Math.max(0, parseInt(document.getElementById('imageCount').textContent) - 1);
        if (folder === 'audio') document.getElementById('audioCount').textContent = Math.max(0, parseInt(document.getElementById('audioCount').textContent) - 1);
        if (folder === 'music') document.getElementById('musicCount').textContent = Math.max(0, parseInt(document.getElementById('musicCount').textContent) - 1);
      } else {
        alert('Delete failed: ' + (data.error || 'unknown error'));
      }
    })
    .catch(e => {
      alert('Delete failed: ' + e.message);
    });
  
  closeDeleteModal();
});

function openLightbox(s, c) {
  document.getElementById('lightbox-img').src = s;
  document.getElementById('lightbox-caption').textContent = c;
  document.getElementById('lightbox').classList.add('active');
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('active');
}
document.getElementById('lightbox').addEventListener('click', closeLightbox);
document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });

async function init() {
  try {
    var r = await fetch('manifest.json?v=' + Date.now());
    if (!r.ok) throw new Error('manifest.json not found - run: ark-add');
    var d = await r.json();
    var v = d.videos || [];
    var i = d.images || [];
    var a = d.audio || [];
    var m = d.music || [];
    document.getElementById('videoGrid').innerHTML = v.length ? v.map(createVideoCard).join('') : '<div class="status-msg">No videos yet</div>';
    document.getElementById('imageGrid').innerHTML = i.length ? i.map(createImageCard).join('') : '<div class="status-msg">No images yet</div>';
    document.getElementById('audioGrid').innerHTML = a.length ? a.map(createAudioCard).join('') : '<div class="status-msg">No audio yet</div>';
    document.getElementById('musicGrid').innerHTML = m.length ? m.map(createMusicCard).join('') : '<div class="status-msg">No music yet - add files to music/ folder</div>';
    document.getElementById('videoCount').textContent = v.length;
    document.getElementById('imageCount').textContent = i.length;
    document.getElementById('audioCount').textContent = a.length;
    document.getElementById('musicCount').textContent = m.length;
    var items = document.querySelectorAll('.gallery-item');
    for (var k = 0; k < items.length; k++) {
      items[k].addEventListener('click', function(e) {
        if (e.target.classList.contains('delete-btn-large')) return;
        openLightbox(this.getAttribute('data-src'), this.getAttribute('data-caption'));
      });
    }
  } catch(e) {
    console.error(e);
    document.getElementById('videoGrid').innerHTML = '<div class="status-msg" style="color:#ff6b6b;">' + e.message + '</div>';
  }
}
init();
</script>
</body>
</html>
HTMLEOF

# Create delete handler script
cat > "$INSTALL_DIR/delete-handler.py" << 'PYEOF'
#!/usr/bin/env python3
"""Simple HTTP server with delete capability"""
import http.server
import socketserver
import os
import json
import urllib.parse

PORT = 9000
DIRECTORY = "/mnt/c/Users/tooex/Downloads/ark-library"

class DeleteHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=DIRECTORY, **kwargs)
    
    def do_GET(self):
        # Parse URL
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        
        # Handle delete request
        if parsed.path == '/delete':
            folder = params.get('folder', [''])[0]
            filename = params.get('file', [''])[0]
            
            # Security: only allow specific folders
            if folder not in ['videos', 'images', 'audio', 'music']:
                self.send_error(400, "Invalid folder")
                return
            
            # Security: prevent path traversal
            if '..' in filename or '/' in filename or '\\' in filename:
                self.send_error(400, "Invalid filename")
                return
            
            filepath = os.path.join(DIRECTORY, folder, filename)
            
            if not os.path.exists(filepath):
                self.send_response(404)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"success": False, "error": "File not found"}).encode())
                return
            
            try:
                # Move to trash instead of deleting
                trash_dir = os.path.join(DIRECTORY, 'trash')
                os.makedirs(trash_dir, exist_ok=True)
                
                # Add timestamp to avoid name conflicts
                import time
                timestamp = str(int(time.time()))
                trash_filename = f"{timestamp}_{filename}"
                trash_path = os.path.join(trash_dir, trash_filename)
                
                os.rename(filepath, trash_path)
                
                # Regenerate manifest
                os.system(f'cd "{DIRECTORY}" && python3 generate-manifest.py > /dev/null 2>&1')
                
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"success": True, "message": "Moved to trash"}).encode())
            except Exception as e:
                self.send_response(500)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"success": False, "error": str(e)}).encode())
            return
        
        # Normal file serving
        return super().do_GET()
    
    def log_message(self, format, *args):
        pass

if __name__ == "__main__":
    os.chdir(DIRECTORY)
    with socketserver.TCPServer(("", PORT), DeleteHandler) as httpd:
        print(f"Server with delete: {DIRECTORY}")
        print(f"http://localhost:{PORT}")
        httpd.serve_forever()
PYEOF

# Update ark to use the new server with delete capability
cat > ~/.local/bin/ark <<'ARK_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
IS_WSL="$(cat ~/.ark_is_wsl 2>/dev/null)"
C_RED='\033[0;31m'; C_GRN='\033[0[32m'; C_CYN='\033[0;36m'; C_YEL='\033[1[33m'; NC='\033[0m'
if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED}ark-library not found at: $ARK_DIR${NC}"; exit 1; fi
pkill -f "http.server 9000" 2>/dev/null; sleep 2
echo -e "${C_CYN}Refreshing...${NC}"
cd "$ARK_DIR"
python3 generate-manifest.py
touch "$ARK_DIR/index.html"
nohup python3 "$ARK_DIR/delete-handler.py" > /tmp/ark-library.log 2>&1 &
sleep 2
if command -v ss >/dev/null 2>&1; then
    ss -tuln 2>/dev/null | grep -q ":9000 " && UP=1 || UP=0
else
    pgrep -f "delete-handler.py" >/dev/null && UP=1 || UP=0
fi
if [ "$UP" = "1" ]; then
    echo -e "${C_GRN}Server started with DELETE!${NC}"
    echo -e "${C_CYN}http://localhost:9000${NC}"
    echo -e "${C_YEL}Press Ctrl+Shift+R! 🗑️ Delete buttons enabled!${NC}"
    [ "$IS_WSL" = "true" ] && powershell.exe -Command "Start-Process 'http://localhost:9000'" 2>/dev/null || xdg-open "http://localhost:9000" 2>/dev/null
else
    echo -e "${C_RED}Server failed${NC}"; cat /tmp/ark-library.log; fi
ARK_EOF
chmod +x ~/.local/bin/ark

# Generate initial manifest
cd "$INSTALL_DIR"
python3 generate-manifest.py

echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}INSTALLATION COMPLETE! v24.4 - Deven Cutting Edition${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${CYAN}NEW FEATURE: Delete buttons on every item!${NC}"
echo -e "${CYAN}Library: $INSTALL_DIR${NC}"
echo ""
echo -e "${CYAN}Commands:${NC}"
echo -e "  ${YELLOW}ark${NC}       - Start (with delete capability)"
echo -e "  ${YELLOW}ark-add${NC}   - Update file list"
echo -e "  ${YELLOW}ark-stop${NC}  - Stop server"
echo -e "  ${YELLOW}ark-trash${NC} - View deleted files"
echo ""
echo -e "${CYAN}URL: ${YELLOW}http://localhost:9000${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
INSTALLER_EOF
)"
