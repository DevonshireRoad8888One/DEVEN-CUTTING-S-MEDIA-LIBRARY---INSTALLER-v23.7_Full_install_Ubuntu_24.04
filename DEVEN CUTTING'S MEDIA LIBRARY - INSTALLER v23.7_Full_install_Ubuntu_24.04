bash -c "$(cat <<'INSTALLER_EOF'
#!/bin/bash
# Library Installer v23.7
# Personalized for Deven Cutting - Blue/Cyan Edition

set -e
shopt -s nullglob
GOLD="\033[0;33m"; GREEN="\033[0;32m"; CYAN="\033[0;36m"
RED="\033[0;31m"; YELLOW="\033[1;33m"; BLUE="\033[0;34m"; NC="\033[0m"
clear
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}     DEVEN CUTTING'S MEDIA LIBRARY - INSTALLER v23.7${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}              Personal Edition - Blue/Cyan Skin${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo ""

if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}Please don't run as root!${NC}"; exit 1; fi

if grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=true
    echo -e "${CYAN}WSL detected${NC}"
else
    IS_WSL=false
    echo -e "${CYAN}Native Linux detected${NC}"
fi
echo ""

if [ "$IS_WSL" = true ]; then
    echo -e "${CYAN}Windows users:${NC}"
    echo ""
    USER_LIST=()
    for user_dir in /mnt/c/Users/*/; do
        user=$(basename "$user_dir")
        if [[ "$user" != "Public" && "$user" != "Default" && "$user" != "Default User" && "$user" != "All Users" ]]; then
            USER_LIST+=("$user")
            echo "   [$(( ${#USER_LIST[@]} ))] $user"
        fi
    done
    echo "   [0] Cancel"
    echo ""
    read -p "Enter number: " USER_CHOICE
    [ "$USER_CHOICE" = "0" ] && exit 0
    if ! [[ "$USER_CHOICE" =~ ^[0-9]+$ ]] || [ "$USER_CHOICE" -lt 1 ] || [ "$USER_CHOICE" -gt "${#USER_LIST[@]}" ]; then
        echo -e "${RED}Invalid!${NC}"; exit 1; fi
    WIN_USER="${USER_LIST[$((USER_CHOICE-1))]}"
    INSTALL_DIR="/mnt/c/Users/$WIN_USER/Downloads/ark-library"
    echo -e "${GREEN}Selected: $WIN_USER${NC}"
else
    INSTALL_DIR="$HOME/ark-library"
    WIN_USER=""
    echo -e "${CYAN}Install: $INSTALL_DIR${NC}"
fi

if [ -d "$INSTALL_DIR" ]; then
    EXISTING_VIDEOS=$(ls "$INSTALL_DIR/videos/" 2>/dev/null | wc -l)
    EXISTING_IMAGES=$(ls "$INSTALL_DIR/images/" 2>/dev/null | wc -l)
    EXISTING_AUDIO=$(ls "$INSTALL_DIR/audio/" 2>/dev/null | wc -l)
    if [ "$EXISTING_VIDEOS" -gt 0 ] || [ "$EXISTING_IMAGES" -gt 0 ] || [ "$EXISTING_AUDIO" -gt 0 ]; then
        echo -e "${YELLOW}Found existing files (will PRESERVE):${NC}"
        echo -e "  Videos: $EXISTING_VIDEOS, Images: $EXISTING_IMAGES, Audio: $EXISTING_AUDIO"
    fi
fi

# Ensure folders exist
for folder in videos images audio; do
    [ -d "$INSTALL_DIR/$folder" ] || mkdir -p "$INSTALL_DIR/$folder"
done

# Manifest generator
cat > "$INSTALL_DIR/generate-manifest.py" << 'PYEOF'
#!/usr/bin/env python3
import os, json
def scan_folder(folder, extensions):
    items = []
    if os.path.exists(folder):
        for f in sorted(os.listdir(folder)):
            if f.lower().endswith(extensions):
                items.append(f)
    return items
videos = scan_folder("videos", (".mp4", ".mov", ".webm", ".avi", ".mkv"))
images = scan_folder("images", (".png", ".jpg", ".jpeg", ".gif", ".webp"))
audio = scan_folder("audio", (".mp3", ".wav", ".ogg", ".m4a", ".flac"))
manifest = {"videos": videos, "images": images, "audio": audio}
with open("manifest.json", "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2, ensure_ascii=False)
print(f"Videos: {len(videos)}, Images: {len(images)}, Audio: {len(audio)}")
PYEOF

# Save config
echo "$INSTALL_DIR" > ~/.ark_install_dir
[ "$IS_WSL" = true ] && echo "true" > ~/.ark_is_wsl || echo "false" > ~/.ark_is_wsl
mkdir -p ~/.local/bin

# ark command
cat > ~/.local/bin/ark <<'ARK_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
IS_WSL="$(cat ~/.ark_is_wsl 2>/dev/null)"
C_RED='\033[0;31m'; C_GRN='\033[0;32m'; C_CYN='\033[0;36m'; C_YEL='\033[1;33m'; NC='\033[0m'
if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED}ark-library not found at: $ARK_DIR${NC}"; exit 1; fi
pkill -f "http.server 9000" 2>/dev/null; sleep 2
echo -e "${C_CYN}Refreshing...${NC}"
cd "$ARK_DIR"
python3 generate-manifest.py
touch "$ARK_DIR/index.html"
nohup python3 -m http.server 9000 --bind 0.0.0.0 > /tmp/ark-library.log 2>&1 &
sleep 2
if command -v ss >/dev/null 2>&1; then
    ss -tuln 2>/dev/null | grep -q ":9000 " && UP=1 || UP=0
else
    pgrep -f "http.server 9000" >/dev/null && UP=1 || UP=0
fi
if [ "$UP" = "1" ]; then
    echo -e "${C_GRN}Server started!${NC}"
    echo -e "${C_CYN}http://localhost:9000${NC}"
    echo -e "${C_YEL}Press Ctrl+Shift+R in browser!${NC}"
    [ "$IS_WSL" = "true" ] && powershell.exe -Command "Start-Process 'http://localhost:9000'" 2>/dev/null || xdg-open "http://localhost:9000" 2>/dev/null
else
    echo -e "${C_RED}Server failed${NC}"; cat /tmp/ark-library.log; fi
ARK_EOF
chmod +x ~/.local/bin/ark

# ark-add command
cat > ~/.local/bin/ark-add <<'ARK_ADD_EOF'
#!/bin/bash
ARK_DIR="$(cat ~/.ark_install_dir 2>/dev/null)"
C_CYN='\033[0;36m'; C_RED='\033[0;31m'; C_GRN='\033[0;32m'; C_YEL='\033[1;33m'; NC='\033[0m'
if [ ! -d "$ARK_DIR" ]; then
    echo -e "${C_RED}ark-library not found!${NC}"; exit 1; fi
cd "$ARK_DIR"
echo -e "${C_CYN}Updating...${NC}"
python3 generate-manifest.py
if [ ! -f "$ARK_DIR/index.html" ]; then
    echo -e "${C_YEL}index.html missing - will be recreated${NC}"; fi
echo -e "${C_GRN}Done! Run: ark-stop && ark${NC}"
ARK_ADD_EOF
chmod +x ~/.local/bin/ark-add

# ark-stop command
cat > ~/.local/bin/ark-stop <<'STOP_EOF'
#!/bin/bash
pkill -f "http.server 9000" 2>/dev/null && echo "Stopped!" || echo "Not running"
STOP_EOF
chmod +x ~/.local/bin/ark-stop

# Add to PATH
if ! grep -q ".local/bin" ~/.bashrc 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc; fi
export PATH="$HOME/.local/bin:$PATH"

# Create the personalized index.html
cat > "$INSTALL_DIR/index.html" << 'HTMLEOF'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deven Cutting's Media Library</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
  background: linear-gradient(135deg, #0a1929 0%, #1e3a5f 50%, #2c5282 100%);
  background-attachment: fixed;
  color: #e8f0f7;
  min-height: 100vh;
  line-height: 1.6;
}
.header {
  text-align: center;
  padding: 60px 20px 40px;
  border-bottom: 2px solid #00d4ff;
  background: rgba(0, 212, 255, 0.05);
}
.header h1 {
  font-size: 2.8rem;
  color: #fff;
  font-weight: 300;
  letter-spacing: 1px;
}
.header .subtitle {
  color: #00d4ff;
  font-size: 1.1rem;
  margin-top: 8px;
  font-weight: 500;
}
.header .name {
  color: #ffd700;
  font-size: 1.3rem;
  margin-top: 15px;
  font-style: italic;
}
.header .tagline {
  color: #b0c4de;
  font-size: 1rem;
  margin-top: 10px;
  font-style: italic;
}
.stats {
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;
  padding: 25px;
  background: rgba(10, 25, 41, 0.6);
  border-bottom: 1px solid rgba(0, 212, 255, 0.3);
}
.stat { text-align: center; }
.stat-number {
  font-size: 2rem;
  color: #00d4ff;
  font-weight: bold;
  display: block;
}
.stat-label {
  font-size: 0.85rem;
  color: #b0c4de;
  text-transform: uppercase;
  letter-spacing: 1px;
}
nav {
  background: rgba(10, 25, 41, 0.95);
  padding: 15px 0;
  text-align: center;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 2px solid #00d4ff;
}
nav a {
  color: #e8f0f7;
  text-decoration: none;
  margin: 0 20px;
  font-weight: 500;
  transition: color 0.3s;
}
nav a:hover {
  color: #00d4ff;
}
section {
  max-width: 1300px;
  margin: 40px auto;
  padding: 0 20px;
}
.section-title {
  font-size: 2rem;
  color: #00d4ff;
  margin-bottom: 25px;
  padding-bottom: 15px;
  border-bottom: 1px solid rgba(0, 212, 255, 0.3);
  font-weight: 300;
}
.video-grid, .audio-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
  gap: 25px;
}
.video-card, .audio-card {
  background: rgba(10, 25, 41, 0.7);
  border: 1px solid rgba(0, 212, 255, 0.2);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
}
.video-card:hover, .audio-card:hover {
  border-color: #00d4ff;
  box-shadow: 0 8px 25px rgba(0, 212, 255, 0.2);
}
.video-wrapper {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  background: #000;
}
.video-wrapper video {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}
.video-info, .audio-info {
  padding: 15px;
}
.video-info h3, .audio-info h3 {
  color: #fff;
  font-size: 0.95rem;
  font-weight: 400;
}
.audio-card audio {
  width: 100%;
  margin-top: 10px;
}
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}
.gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  border: 2px solid rgba(0, 212, 255, 0.2);
  cursor: pointer;
  transition: transform 0.3s, border-color 0.3s;
}
.gallery-item:hover {
  border-color: #00d4ff;
  transform: translateY(-3px);
}
.gallery-item img {
  width: 100%;
  height: 280px;
  object-fit: cover;
  display: block;
}
.gallery-caption {
  padding: 12px;
  text-align: center;
  background: rgba(10, 25, 41, 0.9);
  color: #e8f0f7;
  font-size: 0.85rem;
}
.status-msg {
  text-align: center;
  padding: 40px;
  grid-column: 1/-1;
  color: #b0c4de;
}
footer {
  text-align: center;
  padding: 40px 20px;
  border-top: 2px solid #00d4ff;
  margin-top: 80px;
  background: rgba(10, 25, 41, 0.6);
}
footer h3 {
  color: #00d4ff;
  margin-bottom: 10px;
  font-weight: 400;
}
footer .license {
  color: #ffd700;
  font-size: 0.9rem;
  margin-top: 15px;
}
footer .author {
  color: #b0c4de;
  font-size: 1rem;
  margin-top: 8px;
}
.lightbox {
  display: none;
  position: fixed;
  z-index: 9999;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
.lightbox.active { display: flex; }
.lightbox img {
  max-width: 95%;
  max-height: 85vh;
  object-fit: contain;
  border: 3px solid #00d4ff;
  border-radius: 8px;
}
.lightbox-caption {
  color: #00d4ff;
  margin-top: 15px;
  font-size: 1.1rem;
}
.lightbox-close {
  position: absolute;
  top: 20px;
  right: 30px;
  color: #00d4ff;
  font-size: 2.5rem;
  cursor: pointer;
}
</style>
</head>
<body>
<div class="header">
<h1>📚 Deven Cutting's Media Library</h1>
<div class="subtitle">Personal Collection</div>
<div class="name">— Deven Cutting —</div>
<div class="tagline">Curating Knowledge, Media & Creative Works</div>
</div>

<div class="stats">
<div class="stat"><span class="stat-number" id="videoCount">0</span><span class="stat-label">🎬 Videos</span></div>
<div class="stat"><span class="stat-number" id="imageCount">0</span><span class="stat-label">🖼️ Images</span></div>
<div class="stat"><span class="stat-number" id="audioCount">0</span><span class="stat-label">🎵 Audio</span></div>
</div>

<nav>
<a href="#videos">📺 Videos</a>
<a href="#audio">🎵 Audio</a>
<a href="#gallery">🖼️ Gallery</a>
</nav>

<section id="videos">
<h2 class="section-title">📺 Video Collection</h2>
<div class="video-grid" id="videoGrid"><div class="status-msg">⏳ Loading...</div></div>
</section>

<section id="audio">
<h2 class="section-title">🎵 Audio Collection</h2>
<div class="audio-grid" id="audioGrid"><div class="status-msg">⏳ Loading...</div></div>
</section>

<section id="gallery">
<h2 class="section-title">🖼️ Image Gallery</h2>
<div class="gallery" id="imageGrid"><div class="status-msg">⏳ Loading...</div></div>
</section>

<footer>
<h3>📚 Deven Cutting's Media Library</h3>
<p class="author">Created & Maintained by <strong>Deven Cutting</strong></p>
<p class="license">Released under the MIT License</p>
<p style="margin-top: 15px; opacity: 0.7; font-size: 0.85rem;">
Copyright © 2026 Deven Cutting. All rights reserved.
</p>
<p style="margin-top: 8px; opacity: 0.6; font-size: 0.8rem;">
Permission is hereby granted, free of charge, to any person obtaining a copy of this software
and associated documentation files (the "Software"), to deal in the Software without restriction.
</p>
</footer>

<div class="lightbox" id="lightbox">
<span class="lightbox-close" id="lightbox-close">&times;</span>
<img id="lightbox-img" src="" alt="">
<div class="lightbox-caption" id="lightbox-caption"></div>
</div>

<script>
function cleanName(f) {
  return f.replace(/\.[^.]+$/, '').replace(/^\d{8}_\d+_/, '').replace(/_202\d-\d{2}-\d{2}.*$/, '').replace(/_\([^)]+\)/g, '').replace(/_-_/g, ' - ').replace(/_/g, ' ').trim();
}
function createVideoCard(f) {
  return '<div class="video-card"><div class="video-wrapper"><video controls preload="none"><source src="videos/' + encodeURIComponent(f) + '" type="video/mp4"></video></div><div class="video-info"><h3>' + cleanName(f) + '</h3></div></div>';
}
function createImageCard(f) {
  var name = cleanName(f).replace(/'/g, "\\'");
  return '<div class="gallery-item" data-src="images/' + encodeURIComponent(f) + '" data-caption="' + name + '"><img src="images/' + encodeURIComponent(f) + '" alt="' + name + '" loading="lazy"><div class="gallery-caption">' + name + '</div></div>';
}
function createAudioCard(f) {
  return '<div class="audio-card"><div class="audio-info"><h3>🎵 ' + cleanName(f) + '</h3><audio controls preload="none" style="width:100%; margin-top:10px;"><source src="audio/' + encodeURIComponent(f) + '" type="audio/mpeg"></audio></div></div>';
}
function openLightbox(s, c) {
  document.getElementById('lightbox-img').src = s;
  document.getElementById('lightbox-caption').textContent = c;
  document.getElementById('lightbox').classList.add('active');
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('active');
}
document.getElementById('lightbox').addEventListener('click', closeLightbox);
document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });
async function init() {
  try {
    var r = await fetch('manifest.json?v=' + Date.now());
    if (!r.ok) throw new Error('manifest.json not found - run: ark-add');
    var d = await r.json();
    var v = d.videos || []; var i = d.images || []; var a = d.audio || [];
    document.getElementById('videoGrid').innerHTML = v.length ? v.map(createVideoCard).join('') : '<div class="status-msg">No videos yet</div>';
    document.getElementById('imageGrid').innerHTML = i.length ? i.map(createImageCard).join('') : '<div class="status-msg">No images yet</div>';
    document.getElementById('audioGrid').innerHTML = a.length ? a.map(createAudioCard).join('') : '<div class="status-msg">No audio yet</div>';
    document.getElementById('videoCount').textContent = v.length;
    document.getElementById('imageCount').textContent = i.length;
    document.getElementById('audioCount').textContent = a.length;
    var items = document.querySelectorAll('.gallery-item');
    for (var k = 0; k < items.length; k++) {
      items[k].addEventListener('click', function() {
        openLightbox(this.getAttribute('data-src'), this.getAttribute('data-caption'));
      });
    }
  } catch(e) {
    console.error(e);
    document.getElementById('videoGrid').innerHTML = '<div class="status-msg" style="color:#ff6b6b;">❌ ' + e.message + '</div>';
  }
}
init();
</script>
</body>
</html>
HTMLEOF

# Generate initial manifest
cd "$INSTALL_DIR"
python3 generate-manifest.py

echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}INSTALLATION COMPLETE! v23.7 - Deven Cutting Edition${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${CYAN}Library: $INSTALL_DIR${NC}"
echo -e "${CYAN}Owner: Deven Cutting${NC}"
echo -e "${CYAN}License: MIT${NC}"
echo ""
echo -e "${CYAN}Start: ${YELLOW}ark${NC}"
echo -e "${CYAN}Update: ${YELLOW}ark-add${NC}"
echo -e "${CYAN}URL: ${YELLOW}http://localhost:9000${NC}"
echo ""
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
INSTALLER_EOF
)"
