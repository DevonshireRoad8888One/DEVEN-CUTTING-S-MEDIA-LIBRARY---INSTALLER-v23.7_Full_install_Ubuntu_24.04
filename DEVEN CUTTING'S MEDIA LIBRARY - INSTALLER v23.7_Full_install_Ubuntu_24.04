<a href="#audio">Audio</a>
<a href="#music">Music</a>
<a href="#gallery">Gallery</a>
</nav>

<section id="videos">
<h2 class="section-title">Video Collection</h2>
<div class="video-grid" id="videoGrid"><div class="status-msg">Loading...</div></div>
</section>

<section id="audio">
<h2 class="section-title">Audio Messages</h2>
<div class="audio-grid" id="audioGrid"><div class="status-msg">Loading...</div></div>
</section>

<section id="music">
<h2 class="section-title">Music Library</h2>
<div class="music-grid" id="musicGrid"><div class="status-msg">Loading...</div></div>
</section>

<section id="gallery">
<h2 class="section-title">Image Gallery</h2>
<div class="gallery" id="imageGrid"><div class="status-msg">Loading...</div></div>
</section>

<footer>
<h3>Deven Cutting's Media Library</h3>
<p class="author">Created & Maintained by <strong>Deven Cutting</strong></p>
<p class="license">Released under the MIT License</p>
<p style="margin-top: 15px; opacity: 0.7; font-size: 0.85rem;">Copyright © 2026 Deven Cutting. All rights reserved.</p>
</footer>

<div class="player-modal" id="playerModal">
<span class="player-close" onclick="closePlayer()">&times;</span>
<div class="player-container">
<video id="playerVideo" controls></video>
<div class="player-caption" id="playerCaption"></div>
</div>
</div>

<div class="modal" id="deleteModal">
<div class="modal-content">
<h3>Delete File?</h3>
<p id="deleteMessage">Are you sure?</p>
<div class="modal-buttons">
<button class="modal-btn modal-btn-cancel" onclick="closeDeleteModal()">Cancel</button>
<button class="modal-btn modal-btn-confirm" id="confirmDeleteBtn">Delete</button>
</div>
</div>
</div>

<div class="lightbox" id="lightbox">
<span class="lightbox-close" id="lightbox-close">&times;</span>
<img id="lightbox-img" src="" alt="">
<div class="lightbox-caption" id="lightbox-caption"></div>
</div>

<script>
let deleteTarget = null;
let currentPlayer = null;

function cleanName(f) {
  return f.replace(/\.[^.]+$/, '').replace(/^\d{8}_\d+_/, '').replace(/_202\d-\d{2}-\d{2}.*$/, '').replace(/_\([^)]+\)/g, '').replace(/_-_/g, ' - ').replace(/_/g, ' ').trim();
}

function escAttr(s) {
  return s.replace(/'/g, "\\'").replace(/"/g, "&quot;");
}

function createVideoThumb(f, thumbName) {
  var name = cleanName(f);
  var thumbSrc = thumbName ? 'thumbnails/' + encodeURIComponent(thumbName) : '';
  var fallbackSvg = 'data:image/svg+xml;base64,' + btoa('<svg xmlns="http://www.w3.org/2000/svg" width="640" height="360" viewBox="0 0 640 360"><rect width="640" height="360" fill="#1e3a5f"/><text x="320" y="180" text-anchor="middle" fill="#00d4ff" font-size="24" font-family="sans-serif">No Thumbnail</text></svg>');
  return '<div class="video-thumb" onclick="playVideo(\'videos/' + encodeURIComponent(f) + '\', \'' + escAttr(name) + '\')"><button class="delete-btn" onclick="confirmDelete(\'videos\', \'' + escAttr(f) + '\', event)" title="Delete">×</button><div class="thumb-image"><img src="' + thumbSrc + '" alt="' + escAttr(name) + '" onerror="this.src=\'' + fallbackSvg + '\'" loading="lazy"><div class="play-icon">▶</div></div><div class="thumb-info"><h3>' + name + '</h3></div></div>';
}

function playVideo(src, caption) {
  var modal = document.getElementById('playerModal');
  var video = document.getElementById('playerVideo');
  var cap = document.getElementById('playerCaption');
  if (currentPlayer && currentPlayer !== video) {
    currentPlayer.pause();
  }
  video.src = src;
  cap.textContent = caption;
  modal.classList.add('active');
  video.play();
  currentPlayer = video;
}

function closePlayer() {
  var modal = document.getElementById('playerModal');
  var video = document.getElementById('playerVideo');
  video.pause();
  video.src = '';
  modal.classList.remove('active');
  currentPlayer = null;
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') { closePlayer(); closeDeleteModal(); }
});

function createImageCard(f) {
  var name = cleanName(f);
  return '<div class="gallery-item" data-src="images/' + encodeURIComponent(f) + '" data-caption="' + escAttr(name) + '"><button class="delete-btn-large" onclick="confirmDelete(\'images\', \'' + escAttr(f) + '\', event)" title="Delete">Delete</button><img src="images/' + encodeURIComponent(f) + '" alt="' + escAttr(name) + '" loading="lazy"><div class="gallery-caption">' + name + '</div></div>';
}

function createAudioCard(f) {
  var name = cleanName(f);
  return '<div class="audio-card"><button class="delete-btn" onclick="confirmDelete(\'audio\', \'' + escAttr(f) + '\')" title="Delete">×</button><div class="audio-info"><h3>' + name + '</h3><audio controls preload="none" style="width:100%; margin-top:10px;"><source src="audio/' + encodeURIComponent(f) + '" type="audio/mpeg"></audio></div></div>';
}

function createMusicCard(f) {
  var name = cleanName(f);
  return '<div class="music-card"><button class="delete-btn" onclick="confirmDelete(\'music\', \'' + escAttr(f) + '\')" title="Delete">×</button><div class="music-info"><h3>' + name + '</h3><audio controls preload="none" style="width:100%; margin-top:10px;"><source src="music/' + encodeURIComponent(f) + '" type="audio/mpeg"></audio></div></div>';
}

function confirmDelete(folder, filename, evt) {
  if (evt) evt.stopPropagation();
  deleteTarget = { folder: folder, filename: filename };
  document.getElementById('deleteMessage').textContent = 'Move "' + filename.substring(0, 50) + '" to trash?';
  document.getElementById('deleteModal').classList.add('active');
}

function closeDeleteModal() {
  document.getElementById('deleteModal').classList.remove('active');
  deleteTarget = null;
}

document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
  if (!deleteTarget) return;
  var folder = deleteTarget.folder;
  var filename = deleteTarget.filename;
  fetch('/delete?folder=' + encodeURIComponent(folder) + '&file=' + encodeURIComponent(filename))
    .then(r => r.json())
    .then(data => { if (data.success) location.reload(); else alert('Failed'); })
    .catch(e => alert('Error'));
  closeDeleteModal();
});

function openLightbox(s, c) {
  document.getElementById('lightbox-img').src = s;
  document.getElementById('lightbox-caption').textContent = c;
  document.getElementById('lightbox').classList.add('active');
}

function closeLightbox() {
  document.getElementById('lightbox').classList.remove('active');
}

document.getElementById('lightbox').addEventListener('click', closeLightbox);
document.getElementById('lightbox-close').addEventListener('click', closeLightbox);

async function init() {
  try {
    var r = await fetch('manifest.json?v=' + Date.now());
    if (!r.ok) throw new Error('manifest not found');
    var d = await r.json();
    var v = d.videos || [];
    var i = d.images || [];
    var a = d.audio || [];
    var m = d.music || [];
    var thumbs = d.thumbnails || {};
    document.getElementById('videoGrid').innerHTML = v.length ? v.map(function(f) { return createVideoThumb(f, thumbs[f]); }).join('') : '<div class="status-msg">No videos yet</div>';
    document.getElementById('imageGrid').innerHTML = i.length ? i.map(createImageCard).join('') : '<div class="status-msg">No images yet</div>';
    document.getElementById('audioGrid').innerHTML = a.length ? a.map(createAudioCard).join('') : '<div class="status-msg">No audio yet</div>';
    document.getElementById('musicGrid').innerHTML = m.length ? m.map(createMusicCard).join('') : '<div class="status-msg">No music yet</div>';
    document.getElementById('videoCount').textContent = v.length;
    document.getElementById('imageCount').textContent = i.length;
    document.getElementById('audioCount').textContent = a.length;
    document.getElementById('musicCount').textContent = m.length;
    var items = document.querySelectorAll('.gallery-item');
    for (var k = 0; k < items.length; k++) {
      items[k].addEventListener('click', function(e) {
        if (e.target.classList.contains('delete-btn-large')) return;
        openLightbox(this.getAttribute('data-src'), this.getAttribute('data-caption'));
      });
    }
  } catch(e) {
    console.error(e);
    document.getElementById('videoGrid').innerHTML = '<div class="status-msg" style="color:#ff6b6b;">' + e.message + '</div>';
  }
}
init();
</script>
</body>
</html>
HTMLEOF

# Generate initial manifest + thumbnails
cd "$INSTALL_DIR"
python3 generate-manifest.py

echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}INSTALLATION COMPLETE! v25.3${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${CYAN}🎲 Your RANDOM PORT: ${YELLOW}$RANDOM_PORT${NC}"
echo -e "${CYAN}🔒 Saved to config - never loses!${NC}"
echo ""
echo -e "${CYAN}Commands:${NC}"
echo -e "  ${YELLOW}ark${NC}       - Start (uses port $RANDOM_PORT)"
echo -e "  ${YELLOW}ark-port${NC}  - Show your port"
echo -e "  ${YELLOW}ark-add${NC}   - Update"
echo -e "  ${YELLOW}ark-stop${NC}  - Stop"
echo -e "  ${YELLOW}ark-trash${NC} - View trash"
echo ""
echo -e "${CYAN}URL: ${YELLOW}http://localhost:$RANDOM_PORT${NC}"
echo ""
echo -e "${GREEN}To see your port anytime, type: ark-port${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
INSTALLER_EOF
)"
